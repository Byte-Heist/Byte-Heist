{% component test_cases(cases) %}
  {# Note:
  This macro is also invoked with an empty "cases" object when creating the "initial framework"
  that the JS will use to fill in the test cases after a re-submit.

  So make sure you check if the cases object itself exists before trying to read any data from it.
  
  All the basic divs should be created anyways.
  
  #}
  <div class="result-display-wrapper">
    <div class="result-pass-state">
      {% if not cases %}
      {% elif cases.timedOut %}
        Timeout
      {% elif cases.passed %}
        Pass
      {% else %}
        Fail
      {% endif %}
      {% if cases.points %}{{ cases.points }} points{% endif %}
    </div>
    <div class="time-out-warning warning
                {% if not cases or not cases.timedOut %}hidden{% endif %}">Code timed out after 3 seconds</div>
    <div class="judge-errors
                {% if cases and cases.judgeError %}
                {% else %}
                  hidden
                {% endif %}">
      <h3>Judge Errors</h3>
      <pre class="code-pre">
      {% if cases %}{{ cases.judgeError }}
      {% endif %}</pre>
    </div>
    <div class="test-cases">
      {% if cases.tests %}
        {% for test in cases.tests %}
          <div class="test-case test-{{ test.status | lower }}
                      {% if test.defaultVisible %}
                        default-visible
                      {% else %}
                        default-hidden
                      {% endif %}">
            <div class="test-case-header">
              <img src="/static/triangle.svg" width="32" alt="">
              <h2 class="test-case-title">
                {% if test.title %}{{ test.title }}{% endif %}
              </h2>
              <div class="test-case-status">{{ test.status }}</div>
            </div>
            <div class="test-case-content">{{<test_case_content columns={test.columns} />}}</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
{% endcomponent test_cases %}
{% component test_case_content(columns) %}
  <div class="test-case-column-headings test-case-{{ columns.column_titles | length }}-columns">
    {% for heading in columns.column_titles %}<div>{{ heading }}</div>{% endfor %}
  </div>
  <div class="test-case-columns test-case-{{ columns.column_titles | length }}-columns">
    {% for field in columns.fields %}
      <span class="test-case-column diff-tag-{{ field.kind }}"
            style="grid-row: span {{ field.row_span }};
                   grid-column: {{ field.column + 1 }} / span {{ field.span }}">{{- field.content -}}</span>
    {% endfor %}
  </div>
{% endcomponent test_case_content %}

{% extends "base/base.html.jinja" %}
{% block title %}
  <title>{{ object.name }} - Byte Heist</title>
{% endblock title %}
{% block description %}
  <meta name="description" value="{{ object.description }}" />
{% endblock description %}
{% block content %}
  {% if object.id %}
    {{<challenge_tabs active="post-mortem" id={object.id} name={object.name} author={object.author} />}}
  {% endif %}
  <h1 class="text-3xl font-bold tracking-tighter sm:text-5xl text-white">{{ object.name }}</h1>
  {% set challenge_name = object.name | slugify %}
  {{<language_selector href={"/challenge/"~object.id ~ "/" ~ challenge_name ~ "/solutions/"} selected={object.language} />}}
  {% for solution in object.solutions %}
    <div class="post-mortem-solution
                {% if solution.is_post_mortem %}post-mortem{% endif %}">
      <div class="solution-metadata">
        <dl>
          <dt>Author</dt>
          <dd>
            <a href="/user/{{ solution.author_id }}">
              <img src="{{ solution.author_avatar }}" width="32" alt="">
              <span>{{ solution.author_name }}</span>
            </a>
          </dd>
          <dt>{{ object.unit }}</dt>
          <dd>
            {{ solution.points }}
          </dd>
          <dt>Runtime</dt>
          <dd>
            {{ 1000 * solution.runtime | round }} ms
          </dd>
          <dt>Valid</dt>
          <dd>
            {% if solution.valid %}
              True
            {% else %}
              False
            {% endif %}
          </dd>
          <dt>Post Mortem</dt>
          <dd>
            {% if solution.is_post_mortem %}
              True
            {% else %}
              False
            {% endif %}
          </dd>
        </dl>
      </div>
      {% if solution.code %}
        {% set syntax = object.language | language_syntax %}
        {{- solution.code | syntax_highlight(lang=syntax) -}}
      {% endif %}
    </div>
  {% endfor %}
{% endblock content %}

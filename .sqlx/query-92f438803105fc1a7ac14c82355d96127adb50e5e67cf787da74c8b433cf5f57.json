  "query": "\n                SELECT\n                    points,\n                    is_post_mortem,\n                    language,\n                    author,\n                    accounts.username as \"author_name!\"\n                FROM solutions\n                LEFT JOIN accounts on solutions.author = accounts.id\n                WHERE solutions.id=$1\n            ",
